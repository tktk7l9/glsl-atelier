/**
 * glsl-atelier — Cloudflare Workers (static assets only)
 * https://developers.cloudflare.com/workers/static-assets/
 *
 * ビルド成果物は純粋な静的ファイルなので Worker スクリプト(main)は無い。
 * セキュリティヘッダーは public/_headers が dist へコピーされて効く。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glsl-atelier",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    // Vercel も rewrite 無しの素の静的配信だったので未知パスは 404 のまま。
    "not_found_handling": "404-page",
    // html_handling は既定(auto-trailing-slash)のまま。"none" にすると
    // /sandbox.html の 307 は消えるが / が index.html に解決されなくなり
    // トップが 404 になる(実測済み)。307 先の /sandbox にも _headers 側で
    // 同じ緩和ヘッダーを当てて対処している。
  },
  "observability": {
    "enabled": true,
  },
}
