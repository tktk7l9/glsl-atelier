# Cloudflare Workers static assets のヘッダー定義。vercel.json の headers を
# 移植したもの(Vercel 側にも同じ内容を残してある)。
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# ⚠️ vercel.json は負の先読み `/((?!sandbox\.html).*)` で除外していたが、
# _headers にその表現は無く、複数ルールが一致すると値がカンマで連結される
# (= CSP が2本になりブラウザは積集合を取るのでサンドボックスが壊れる)。
# そのため `! Header-Name` で先行ルール分を明示的に剥がしてから貼り直す。
# 併せて、既定の html_handling が /sandbox.html を /sandbox へ 307 するので
# 両方のパスに同じ緩和ヘッダーを当てている。

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; child-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# 学習者のコードを実行する不透明オリジンのサンドボックス。inline/eval を
# 許す代わりに connect-src を none にして外部通信を断つ。
/sandbox.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Referrer-Policy
  Referrer-Policy: no-referrer

/sandbox
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Referrer-Policy
  Referrer-Policy: no-referrer

# Vite が内容ハッシュ付きで吐くので恒久キャッシュ可。Vercel が自動で付けて
# いた immutable 相当を明示する。
/assets/*
  Cache-Control: public, max-age=31536000, immutable
