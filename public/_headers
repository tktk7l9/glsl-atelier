# Header rules for Cloudflare Workers static assets, ported from the headers in
# vercel.json (the same content is also kept on the Vercel side).
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# ⚠️ vercel.json excluded the sandbox with a negative lookahead `/((?!sandbox\.html).*)`,
# but _headers has no such syntax, and when several rules match, their values are
# joined with commas (= two CSPs, and the browser takes their intersection, which
# breaks the sandbox). So `! Header-Name` explicitly strips the earlier rule's value
# before setting it again. Also, the default html_handling 307-redirects
# /sandbox.html to /sandbox, so the same relaxed headers are applied to both paths.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self'; child-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Opaque-origin sandbox that runs the learner's code. In exchange for allowing
# inline/eval, connect-src is set to none to cut off external requests.
/sandbox.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Referrer-Policy
  Referrer-Policy: no-referrer

/sandbox
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Referrer-Policy
  Referrer-Policy: no-referrer

# Vite emits these with content hashes, so they can be cached forever. This makes
# explicit the immutable caching that Vercel used to add automatically.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
