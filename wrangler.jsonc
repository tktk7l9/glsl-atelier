/**
 * glsl-atelier — Cloudflare Workers (static assets only)
 * https://developers.cloudflare.com/workers/static-assets/
 *
 * The build output is purely static files, so there is no Worker script (main).
 * Security headers take effect from public/_headers, which is copied into dist.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glsl-atelier",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    // Vercel also served plain static files without rewrites, so unknown paths stay 404.
    "not_found_handling": "404-page",
    // html_handling stays at the default (auto-trailing-slash). Setting it to "none"
    // removes the /sandbox.html 307, but / no longer resolves to index.html and
    // the top page becomes 404 (verified). Instead, _headers applies the same
    // relaxed headers to the 307 target /sandbox as well.
  },
  "observability": {
    "enabled": true,
  },
}
