{
  "name": "glsl-atelier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "手を動かして学ぶインタラクティブ WebGL / Three.js 学習アプリ。GLSL フラグメントシェーダーと Three.js シーン構築を書いて、ライブ描画＋自動採点でクリアする（宇宙天文台 / Shader Lab テーマ）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
